PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # printed by `npm run webhook:setup`
PAYPAL_MERCHANT_EMAIL=        # sandbox Business account
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-flash-latest
APP_BASE_URL=                 # the Render URL once deployed
DATABASE_PATH=./data/audit.db
PAYPAL_DEMO_VAULT_ID=         # optional: a saved sandbox buyer PayPal, so demo purchases need no buyer approval
AUTO_SEED=true                # load the demo data when the server starts with an empty ledger
